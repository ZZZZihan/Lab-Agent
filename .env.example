# Copy to .env with scripts/init-env.sh. These placeholders are rejected on startup.
APP_ENV=dev
POSTGRES_PASSWORD=replace-me-postgres-password
DATABASE_URL=postgresql+asyncpg://labagent:replace-me-postgres-password@127.0.0.1:55432/labagent
REDIS_PASSWORD=replace-me-redis-password
REDIS_URL=redis://:replace-me-redis-password@127.0.0.1:56379/0
JWT_SECRET=replace-me-with-a-long-random-string
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
LLM_PROVIDER=fake
LLM_MODEL=fake-grounded-v1
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_API_KEY_FILE=~/.config/lab-agent/magpie.key
# JUDGE_MODEL=
# JUDGE_API_KEY_FILE=~/.config/lab-agent/magpie-judge.key
# JUDGE_BASE_URL=

# Embedding profile (default: offline hashing baseline for CI and zero-dependency dev)
EMBEDDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_STORAGE=vector
EMBEDDING_INDEX=auto
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_API_KEY_FILE=
# EMBEDDING_MODEL_VERSION=
# EMBEDDING_NATIVE_DIM=
# EMBEDDING_TRUNCATE=false
# EMBEDDING_SEND_DIMENSIONS=false
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_TIMEOUT_SECONDS=120
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_QUERY_TEMPLATE={query}
# EMBEDDING_QUERY_INSTRUCTION=
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_REDACT=false

# Profile 1: Qwen3-Embedding-8B full 4096-dim on host Ollama (exact cosine scan)
# EMBEDDER=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:8b
# EMBEDDING_MODEL_VERSION=64b933495768
# EMBEDDING_DIM=4096
# EMBEDDING_NATIVE_DIM=4096
# EMBEDDING_TRUNCATE=false
# EMBEDDING_STORAGE=vector
# EMBEDDING_INDEX=auto
# EMBEDDING_QUERY_TEMPLATE=Instruct: {instruction}\nQuery:{query}
# EMBEDDING_QUERY_INSTRUCTION=Given a question from a research lab member, retrieve the lab document passage that answers it

# Profile 2: Qwen3-Embedding-8B MRL truncated to 1024-dim (HNSW vector index)
# EMBEDDER=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:8b
# EMBEDDING_MODEL_VERSION=64b933495768
# EMBEDDING_DIM=1024
# EMBEDDING_NATIVE_DIM=4096
# EMBEDDING_TRUNCATE=true
# EMBEDDING_STORAGE=vector
# EMBEDDING_INDEX=hnsw
# EMBEDDING_QUERY_TEMPLATE=Instruct: {instruction}\nQuery:{query}
# EMBEDDING_QUERY_INSTRUCTION=Given a question from a research lab member, retrieve the lab document passage that answers it

# Profile 3: Containerized Ollama on Linux (`docker compose --profile linux-embed up -d` or `./scripts/init-env.sh --linux-embed`)
# EMBEDDER=openai_compatible
# EMBEDDING_BASE_URL=http://embedder:11434/v1
# EMBEDDING_MODEL=lab-agent-qwen3-embed
# EMBEDDING_MODEL_VERSION=64b933495768
# EMBEDDING_DIM=4096
# EMBEDDING_NATIVE_DIM=4096
# EMBEDDING_TRUNCATE=false
# EMBEDDING_STORAGE=halfvec
# EMBEDDING_INDEX=auto
# EMBEDDING_QUERY_TEMPLATE=Instruct: {instruction}\nQuery:{query}
# EMBEDDING_QUERY_INSTRUCTION=Given a question from a research lab member, retrieve the lab document passage that answers it

# Optional host-only local BGE via sentence-transformers (not bundled in Docker image; requires `uv sync --extra bge`).
# Note: To run bge-family models (e.g. bge-m3) via Ollama, use EMBEDDER=openai_compatible instead.
# EMBEDDER=bge
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_MODEL_VERSION=
# EMBEDDING_DIM=512
# EMBEDDING_QUERY_TEMPLATE=为这个句子生成表示以用于检索相关文章：{query}
# EMBEDDING_DOCUMENT_PREFIX=

RERANKER=off
RERANKER_MODEL=BAAI/bge-reranker-base
LOAD_TUNED_CONFIG=true
CALIBRATION_DIR=./data/calibrations
AUDIT_RETENTION_DAYS=180
UPLOAD_DIR=./data/uploads
OTEL_EXPORTER=none
# OTEL_ENDPOINT=http://localhost:4318/v1/traces
# INTERNAL_PROXY_SECRET=
RATE_LIMIT_ENABLED=true
LOGIN_IP_RATE_LIMIT=30
LOGIN_IP_RATE_WINDOW_SECONDS=60
LOGIN_ACCOUNT_RATE_LIMIT=10
LOGIN_ACCOUNT_RATE_WINDOW_SECONDS=900
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:43123
API_INTERNAL_URL=http://127.0.0.1:43124
NEXT_PUBLIC_DEMO_HINTS=true
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_JSON=
