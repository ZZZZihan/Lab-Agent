# Copy to .env with scripts/init-env.sh. These placeholders are rejected on startup.
APP_ENV=dev
POSTGRES_PASSWORD=replace-me-postgres-password
DATABASE_URL=postgresql+asyncpg://labagent:replace-me-postgres-password@127.0.0.1:55432/labagent
REDIS_URL=redis://127.0.0.1:56379/0
JWT_SECRET=replace-me-with-a-long-random-string
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
LLM_PROVIDER=fake
LLM_MODEL=fake-grounded-v1
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
EMBEDDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RERANKER=off
RERANKER_MODEL=BAAI/bge-reranker-base
LOAD_TUNED_CONFIG=true
AUDIT_RETENTION_DAYS=180
UPLOAD_DIR=./data/uploads
OTEL_EXPORTER=none
# OTEL_ENDPOINT=http://localhost:4318/v1/traces
RATE_LIMIT_ENABLED=true
COOKIE_SECURE=false
API_INTERNAL_URL=http://127.0.0.1:43124
NEXT_PUBLIC_DEMO_HINTS=true
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_JSON=
